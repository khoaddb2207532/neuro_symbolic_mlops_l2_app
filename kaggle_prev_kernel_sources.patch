@@ -0,0 +1,71 @@
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+from kaggle_assignment import (  # noqa: E402
+    build_previous_index,
+    owner_assignment,
+    previous_notebook_name,
+    round_robin_assignment,
+    slug_of,
+)
+
+BACKBONES = ["alexnet", "mobilenetv3_small", "resnet50", "swin_t", "vit_b_32"]
+PAIRS = [(42, 44), (46, 48)]
+ACCOUNTS = [{"username": f"acc{i}", "token": f"t{i}"} for i in range(1, 6)]
+
+
+def _names(prefix):
+    return [Path(f"{prefix}_{bb}_seeds_{a}_{b}.ipynb") for bb in BACKBONES for a, b in PAIRS]
+
+
+def test_slug_matches_push_script_rule():
+    assert slug_of(Path("cbm_resnet50_seeds_42_44").stem) == "cbm-resnet50-seeds-42-44"
+
+
+def test_previous_name_mapping():
+    assert previous_notebook_name("concept_rules_swin_t_seeds_46_48.ipynb") == "cbm_swin_t_seeds_46_48.ipynb"
+    with pytest.raises(ValueError):
+        previous_notebook_name("cbm_resnet50_seeds_42_44.ipynb")
+
+
+def test_round_robin_gives_two_per_account():
+    pairs = round_robin_assignment(_names("cbm"), ACCOUNTS)
+    per = {}
+    for acc, _ in pairs:
+        per[acc["username"]] = per.get(acc["username"], 0) + 1
+    assert set(per.values()) == {2}
+
+
+def test_previous_index_matches_round_robin_owner():
+    idx = build_previous_index(_names("cbm"), ACCOUNTS)
+    owner, kernel = idx["cbm_resnet50_seeds_42_44.ipynb"]
+    # sắp xếp theo tên: alexnet(2) mobilenet(2) resnet50(2) ... -> resnet50 thuộc acc3
+    assert owner == "acc3"
+    assert kernel == "acc3/cbm-resnet50-seeds-42-44"
+
+
+def test_owner_assignment_pushes_each_concept_from_predecessor_owner():
+    prev = _names("cbm")
+    idx = build_previous_index(prev, ACCOUNTS)
+    plan = owner_assignment(_names("concept_rules"), idx, ACCOUNTS)
+    assert len(plan) == 10
+    for acc, nb, kernel in plan:
+        old = previous_notebook_name(nb.name)
+        assert acc["username"] == idx[old][0]
+        assert kernel == idx[old][1]
+        assert kernel.startswith(acc["username"] + "/")
+
+
+def test_owner_assignment_fails_fast_on_missing_predecessor():
+    idx = build_previous_index(_names("cbm")[:4], ACCOUNTS)  # thiếu vit_b_32 và swin_t
+    with pytest.raises(RuntimeError, match="thiếu notebook cũ"):
+        owner_assignment(_names("concept_rules"), idx, ACCOUNTS)
+
+
+def test_owner_not_in_accounts_fails():
+    idx = {"cbm_alexnet_seeds_42_44.ipynb": ("ghost", "ghost/cbm-alexnet-seeds-42-44")}
+    with pytest.raises(RuntimeError, match="không có trong accounts.json"):
+        owner_assignment([Path("concept_rules_alexnet_seeds_42_44.ipynb")], idx, ACCOUNTS)
